{
  "name": "dsh-system-monitor-plugin",
  "version": "0.3.3",
  "description": "面向 dsh 的插件: 监控 dsh 进程及其派生子进程的资源占用, 并以面板图表报告整机与各会话的 CPU 与内存占用",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JularDepick/dsh-system-monitor-plugin.git"
  },
  "author": {
    "name": "JularDepick",
    "url": "https://github.com/JularDepick"
  },
  "homepage": "https://github.com/JularDepick/dsh-system-monitor-plugin#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "system-monitor",
    "process-monitor",
    "resource-monitor",
    "cpu",
    "memory"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <=0.2.2-rc.2"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "src/translation/*.ini",
    "src/translation/.example_zh-CN.ini",
    "README*",
    "COPYRIGHT"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/syntax-check.mjs && node scripts/check-client-bundle.mjs",
    "prepare": "pnpm build",
    "postpack": "node scripts/clean-release.cjs && node scripts/pack-to-release.cjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <=0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
